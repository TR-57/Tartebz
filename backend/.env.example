# ---- App ----
APP_NAME=Tartebz
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Bahrain
APP_URL=https://example.com
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# ---- Store addresses and cookies ----
STORE_URL=https://example.com
ADMIN_URL=https://example.com/admin/
COOKIE_DOMAIN=
COOKIE_SECURE=true
TRUST_PROXY=false

# ---- Database ----
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---- Cache (database or redis) ----
CACHE_STORE=database
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PREFIX=tz_
REDIS_PASSWORD=

# ---- Mail (fallback; Admin > Settings > Email wins) ----
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
STORE_NOTIFY_EMAIL=

# ---- Payments (fallbacks; keys are normally entered in the admin) ----
TAP_SECRET_KEY=
TAP_MERCHANT_ID=
TABBY_PUBLIC_KEY=
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=

# ---- Files ----
UPLOAD_DIR=
UPLOAD_URL=/uploads
THUMB_DIR=

# ---- Test stand-ins only (leave empty in production) ----
TAP_API_BASE=
TABBY_BASE=
FLOOSS_BASE=
SMSA_API_BASE=
META_API_BASE=
TIKTOK_API_BASE=
GOOGLE_API_BASE=
GOOGLE_TOKEN_URL=
GOOGLE_SIGNIN_AUTH_URL=
GOOGLE_SIGNIN_TOKEN_URL=

# ---- Scripts ----
ADMIN_PASSWORD=
OFFSITE_KEEP_DAYS=90

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
