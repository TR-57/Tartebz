# Tartebz – public_html/.htaccess (Hostinger, LiteSpeed/Apache). Copied by deploy.sh as public_html/.htaccess.
Options -Indexes
DirectoryIndex index.html
RewriteEngine On

# Always HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The app's own files never leave the server
RewriteRule (^|/)\.(?!well-known) - [F]

# API -> Laravel (lives outside public_html, see api.php)
RewriteRule ^api(/|$) api.php [END,QSA]

# Product pages (built with link-preview and Google tags), sitemap and robots come from Laravel.
# Old WordPress product addresses (/product/<arabic-name>/) are redirected there too.
RewriteRule ^product/.+ api.php [END,QSA]
RewriteRule ^(sitemap\.xml|robots\.txt)$ api.php [END,QSA]
# Apple Pay domain check (file uploaded in Admin › Payments)
RewriteRule ^\.well-known/apple-developer-merchantid-domain-association$ api.php [END,QSA]

# Link-preview pictures (1200x630 JPEG): from disk when made, otherwise Laravel makes it once.
RewriteCond %{DOCUMENT_ROOT}/img/og/$1.jpg -f
RewriteRule ^img/og/((?:uploads|assets)/.+)$ img/og/$1.jpg [END,T=image/jpeg]
RewriteRule ^img/og/ api.php [END,QSA]

# Resized image copies: serve from disk when made, otherwise Laravel makes it once.
RewriteCond %{DOCUMENT_ROOT}/img/$1.webp -f
RewriteRule ^img/(\d+/(?:uploads|assets)/.+)$ img/$1.webp [END,T=image/webp]
RewriteRule ^img/\d+/(?:uploads|assets)/ api.php [END,QSA]

# Old WordPress addresses
RewriteRule ^wp-content/uploads/(.+)$ /uploads/wp/$1 [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php) /admin/ [R=302,L]

# Clean URLs: /shop -> shop.html, /about.html -> /about
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ $1.html [END]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "geolocation=(), microphone=(), payment=(self)"
  # Pages: always ask the server (Cloudflare and browsers revalidate, so a deploy shows at once).
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # CSS / JS / fonts carry ?v=<deploy> in their links (deploy.sh), so they can be kept for a year.
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # …except the orders board's service worker, which must always be fresh (it comes after, so it wins).
  <FilesMatch "^staff-sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Pictures: originals keep their address when replaced (?v= changes), resized copies are rebuilt.
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>
